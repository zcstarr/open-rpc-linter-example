{
  "openrpc": "1.3.2",
  "info": {
    "title": "Car Purchase API",
    "version": "1.0.0",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "description": "JSON-RPC methods for searching inventory, financing, and completing a vehicle purchase. The included HTTP server implements searchInventory only; the other methods are illustrative contracts."
  },
  "servers": [
    {
      "name": "Local inventory search",
      "url": "http://127.0.0.1:3000",
      "description": "Fixture-backed searchInventory only. Other methods return -32601 Method not found."
    }
  ],
  "methods": [
    {
      "name": "searchInventory",
      "summary": "Search available vehicles",
      "description": "Returns vehicles matching make, model, maximum price, and optional vehicle type, ranked by location. Filters are combined. Omitting vehicleType includes all vehicle types.",
      "params": [
        {
          "name": "make",
          "description": "Vehicle manufacturer (e.g. Toyota, Ford).",
          "schema": {
            "title": "Vehicle make",
            "description": "Manufacturer name to match exactly, such as Toyota or Ford.",
            "type": "string"
          }
        },
        {
          "name": "model",
          "description": "Vehicle model name.",
          "schema": {
            "title": "Vehicle model",
            "description": "Model name to match exactly, such as Camry or Transit.",
            "type": "string"
          }
        },
        {
          "name": "maxPrice",
          "description": "Maximum price in USD.",
          "schema": {
            "title": "Maximum price",
            "description": "Inclusive upper limit on the listed vehicle price, in USD.",
            "type": "number",
            "minimum": 0
          }
        },
        {
          "name": "zipCode",
          "description": "Postal code used to rank nearby inventory.",
          "required": true,
          "schema": {
            "title": "Search ZIP code",
            "description": "Five-digit US ZIP code or ZIP+4 used as the search origin.",
            "type": "string",
            "pattern": "^\\d{5}(-\\d{4})?$"
          }
        },
        {
          "name": "vehicleType",
          "description": "Optional vehicle classification: sedan, truck, or van (exact lowercase values). Other strings and non-string values, including null, return -32602 Invalid params. Omit this parameter to include all vehicle types.",
          "required": false,
          "schema": {
            "title": "Vehicle type",
            "description": "Exact lowercase vehicle classification.",
            "type": "string",
            "enum": ["sedan", "truck", "van"]
          }
        }
      ],
      "result": {
        "name": "vehicles",
        "description": "Matching vehicles sorted by distance and price.",
        "schema": {
          "title": "Matching inventory",
          "description": "Listings that satisfy every supplied filter, ordered by distance and then price.",
          "type": "array",
          "items": { "$ref": "#/components/schemas/VehicleListing" }
        }
      },
      "errors": [
        {
          "code": -32602,
          "message": "Invalid params",
          "description": "The required ZIP code is missing or a search filter has an invalid name, type, or value."
        },
        {
          "code": -32001,
          "message": "No inventory found for the given filters",
          "description": "No listing satisfies all supplied search filters."
        }
      ],
      "examples": [
        {
          "name": "Search Toyota sedans near Austin",
          "description": "Find a Toyota Camry sedan priced at most 30000 USD near ZIP code 78701.",
          "params": [
            { "name": "make", "value": "Toyota" },
            { "name": "model", "value": "Camry" },
            { "name": "maxPrice", "value": 30000 },
            { "name": "zipCode", "value": "78701" },
            { "name": "vehicleType", "value": "sedan" }
          ],
          "result": {
            "name": "vehicles",
            "value": [
              {
                "id": "veh-1001",
                "make": "Toyota",
                "model": "Camry",
                "vehicleType": "sedan",
                "year": 2024,
                "price": 28999,
                "mileage": 12,
                "color": "Silver",
                "vin": "4T1B11HK1KU123456"
              }
            ]
          }
        },
        {
          "name": "Search Toyota trucks near Austin",
          "description": "Combine manufacturer and truck filters.",
          "params": [
            { "name": "make", "value": "Toyota" },
            { "name": "zipCode", "value": "78701" },
            { "name": "vehicleType", "value": "truck" }
          ],
          "result": {
            "name": "vehicles",
            "value": [
              {
                "id": "veh-2002",
                "make": "Toyota",
                "model": "Tacoma",
                "vehicleType": "truck",
                "year": 2024,
                "price": 35999,
                "mileage": 40
              }
            ]
          }
        },
        {
          "name": "Search affordable vans near Dallas",
          "description": "Combine maximum price and van filters.",
          "params": [
            { "name": "maxPrice", "value": 35000 },
            { "name": "zipCode", "value": "75201" },
            { "name": "vehicleType", "value": "van" }
          ],
          "result": {
            "name": "vehicles",
            "value": [
              {
                "id": "veh-3001",
                "make": "Ford",
                "model": "Transit",
                "vehicleType": "van",
                "year": 2023,
                "price": 34999,
                "mileage": 12000
              }
            ]
          }
        }
      ]
    },
    {
      "name": "getVehicleDetails",
      "summary": "Get vehicle details",
      "description": "Returns full specifications and pricing for a single vehicle listing.",
      "params": [
        {
          "name": "vehicleId",
          "description": "Unique inventory identifier.",
          "required": true,
          "schema": {
            "title": "Vehicle ID",
            "description": "Inventory identifier of the listing to retrieve.",
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "vehicle",
        "description": "Detailed vehicle listing.",
        "schema": { "$ref": "#/components/schemas/VehicleListing" }
      },
      "errors": [
        {
          "code": -32602,
          "message": "Invalid params",
          "description": "The vehicle identifier is missing or a supplied parameter has an invalid type or value."
        },
        {
          "code": -32002,
          "message": "Vehicle not found",
          "description": "No inventory listing exists for the supplied vehicle identifier."
        }
      ],
      "examples": [
        {
          "name": "Get listing details",
          "description": "Retrieve the specifications and price of listing veh-1001.",
          "params": [{ "name": "vehicleId", "value": "veh-1001" }],
          "result": {
            "name": "vehicle",
            "value": {
              "id": "veh-1001",
              "make": "Toyota",
              "model": "Camry",
              "year": 2024,
              "price": 28999,
              "mileage": 12,
              "color": "Silver",
              "vin": "4T1B11HK1KU123456"
            }
          }
        }
      ]
    },
    {
      "name": "requestQuote",
      "summary": "Request a purchase quote",
      "description": "Calculates out-the-door pricing including taxes, fees, trade-in credit, and optional add-ons.",
      "params": [
        {
          "name": "vehicleId",
          "description": "Vehicle to quote.",
          "required": true,
          "schema": {
            "title": "Vehicle ID",
            "description": "Inventory identifier of the vehicle to price in the quote.",
            "type": "string"
          }
        },
        {
          "name": "tradeInVin",
          "description": "Optional VIN for trade-in valuation.",
          "schema": {
            "title": "Trade-in VIN",
            "description": "Vehicle identification number of the buyer's trade-in.",
            "type": "string"
          }
        },
        {
          "name": "addOns",
          "description": "Optional dealer add-ons (e.g. extended warranty, floor mats).",
          "schema": {
            "title": "Dealer add-ons",
            "description": "Identifiers of optional dealer products to include in the quote.",
            "type": "array",
            "items": { "type": "string" }
          }
        }
      ],
      "result": {
        "name": "quote",
        "description": "Itemized purchase quote.",
        "schema": { "$ref": "#/components/schemas/PurchaseQuote" }
      },
      "errors": [
        {
          "code": -32602,
          "message": "Invalid params",
          "description": "The vehicle identifier is missing or a quote parameter has an invalid type or value."
        },
        {
          "code": -32002,
          "message": "Vehicle not found",
          "description": "No inventory listing exists for the vehicle being quoted."
        }
      ],
      "examples": [
        {
          "name": "Quote with trade-in",
          "description": "Quote listing veh-1001 with trade-in credit and an extended warranty.",
          "params": [
            { "name": "vehicleId", "value": "veh-1001" },
            { "name": "tradeInVin", "value": "1HGCM82633A123456" },
            { "name": "addOns", "value": ["extended-warranty"] }
          ],
          "result": {
            "name": "quote",
            "value": {
              "quoteId": "quote-9001",
              "vehicleId": "veh-1001",
              "subtotal": 28999,
              "taxes": 2175,
              "fees": 499,
              "tradeInCredit": 8000,
              "total": 23673
            }
          }
        }
      ]
    },
    {
      "name": "applyForFinancing",
      "summary": "Submit a financing application",
      "description": "Submits buyer information for loan pre-approval and returns available terms.",
      "params": [
        {
          "name": "vehicleId",
          "description": "Vehicle being financed.",
          "required": true,
          "schema": {
            "title": "Vehicle ID",
            "description": "Inventory identifier of the vehicle in the financing application.",
            "type": "string"
          }
        },
        {
          "name": "applicant",
          "description": "Primary buyer information.",
          "required": true,
          "schema": { "$ref": "#/components/schemas/Applicant" }
        },
        {
          "name": "downPayment",
          "description": "Planned down payment in USD.",
          "schema": {
            "title": "Down payment",
            "description": "Amount the buyer plans to pay upfront, in USD.",
            "type": "number",
            "minimum": 0
          }
        }
      ],
      "result": {
        "name": "financingOffer",
        "description": "Pre-approved financing terms, if eligible.",
        "schema": { "$ref": "#/components/schemas/FinancingOffer" }
      },
      "errors": [
        {
          "code": -32602,
          "message": "Invalid params",
          "description": "Required vehicle or applicant information is missing, or a financing parameter is invalid."
        },
        {
          "code": -32003,
          "message": "Financing application declined",
          "description": "The submitted application does not qualify for a financing offer."
        }
      ],
      "examples": [
        {
          "name": "Pre-approval request",
          "description": "Submit an applicant's income and employment details with a 5000 USD down payment.",
          "params": [
            { "name": "vehicleId", "value": "veh-1001" },
            {
              "name": "applicant",
              "value": {
                "fullName": "Alex Rivera",
                "email": "alex@example.com",
                "annualIncome": 85000,
                "employmentYears": 4
              }
            },
            { "name": "downPayment", "value": 5000 }
          ],
          "result": {
            "name": "financingOffer",
            "value": {
              "offerId": "fin-7001",
              "apr": 5.9,
              "termMonths": 60,
              "monthlyPayment": 412.5
            }
          }
        }
      ]
    },
    {
      "name": "scheduleTestDrive",
      "summary": "Schedule a test drive",
      "description": "Books an appointment to test drive a vehicle at a dealership.",
      "params": [
        {
          "name": "vehicleId",
          "description": "Vehicle to test drive.",
          "required": true,
          "schema": {
            "title": "Vehicle ID",
            "description": "Inventory identifier of the vehicle requested for the test drive.",
            "type": "string"
          }
        },
        {
          "name": "preferredTime",
          "description": "Requested appointment time in ISO 8601 format.",
          "required": true,
          "schema": {
            "title": "Preferred test-drive time",
            "description": "Requested test-drive timestamp in ISO 8601 format, including a time-zone offset.",
            "type": "string",
            "format": "date-time"
          }
        },
        {
          "name": "contact",
          "description": "Buyer contact details for confirmation.",
          "required": true,
          "schema": { "$ref": "#/components/schemas/ContactInfo" }
        }
      ],
      "result": {
        "name": "appointment",
        "description": "Confirmed test drive appointment.",
        "schema": { "$ref": "#/components/schemas/TestDriveAppointment" }
      },
      "errors": [
        {
          "code": -32602,
          "message": "Invalid params",
          "description": "Required vehicle, appointment time, or contact information is missing or invalid."
        },
        {
          "code": -32004,
          "message": "Requested time slot unavailable",
          "description": "The dealership cannot book the requested vehicle at the preferred time."
        }
      ],
      "examples": [
        {
          "name": "Weekend test drive",
          "description": "Book listing veh-1001 at the requested time and return dealership confirmation details.",
          "params": [
            { "name": "vehicleId", "value": "veh-1001" },
            { "name": "preferredTime", "value": "2026-09-27T10:00:00Z" },
            {
              "name": "contact",
              "value": {
                "fullName": "Alex Rivera",
                "phone": "+15125550100",
                "email": "alex@example.com"
              }
            }
          ],
          "result": {
            "name": "appointment",
            "value": {
              "appointmentId": "td-3001",
              "vehicleId": "veh-1001",
              "scheduledAt": "2026-09-27T10:00:00Z",
              "dealershipAddress": "123 Main St, Austin, TX 78701"
            }
          }
        }
      ]
    },
    {
      "name": "completePurchase",
      "summary": "Complete a vehicle purchase",
      "description": "Finalizes the sale after quote acceptance, financing selection, and identity verification.",
      "params": [
        {
          "name": "quoteId",
          "description": "Accepted quote identifier from requestQuote.",
          "required": true,
          "schema": {
            "title": "Accepted quote ID",
            "description": "Identifier of the purchase quote accepted by the buyer.",
            "type": "string"
          }
        },
        {
          "name": "financingOfferId",
          "description": "Selected financing offer, if paying with a loan.",
          "schema": {
            "title": "Selected financing offer ID",
            "description": "Identifier of the financing offer used to fund the purchase.",
            "type": "string"
          }
        },
        {
          "name": "paymentMethod",
          "description": "How the buyer will pay remaining balance.",
          "required": true,
          "schema": {
            "title": "Payment method",
            "description": "Payment arrangement selected by the buyer: cash, financing, or lease.",
            "type": "string",
            "enum": ["cash", "financing", "lease"]
          }
        }
      ],
      "result": {
        "name": "purchase",
        "description": "Completed purchase record with delivery details.",
        "schema": { "$ref": "#/components/schemas/PurchaseRecord" }
      },
      "errors": [
        {
          "code": -32602,
          "message": "Invalid params",
          "description": "Required quote or payment information is missing, or a purchase parameter is invalid."
        },
        {
          "code": -32005,
          "message": "Quote expired or already completed",
          "description": "The accepted quote can no longer be used because it expired or already produced a purchase."
        }
      ],
      "examples": [
        {
          "name": "Financed purchase",
          "description": "Complete an accepted quote using the buyer's selected financing offer.",
          "params": [
            { "name": "quoteId", "value": "quote-9001" },
            { "name": "financingOfferId", "value": "fin-7001" },
            { "name": "paymentMethod", "value": "financing" }
          ],
          "result": {
            "name": "purchase",
            "value": {
              "purchaseId": "pur-5001",
              "vehicleId": "veh-1001",
              "totalPaid": 23673,
              "estimatedDeliveryDate": "2026-10-05"
            }
          }
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "VehicleListing": {
        "title": "Vehicle listing",
        "type": "object",
        "description": "A vehicle available for purchase.",
        "required": ["id", "make", "model", "year", "price", "mileage"],
        "properties": {
          "id": { "type": "string", "description": "Inventory identifier." },
          "make": { "type": "string", "description": "Manufacturer." },
          "model": { "type": "string", "description": "Model name." },
          "vehicleType": {
            "type": "string",
            "enum": ["sedan", "truck", "van"],
            "description": "Vehicle classification, when supplied. Optional for compatibility with existing listings."
          },
          "year": { "type": "integer", "minimum": 1900, "description": "Model year." },
          "price": { "type": "number", "minimum": 0, "description": "Listed price in USD." },
          "mileage": { "type": "number", "minimum": 0, "description": "Odometer reading in miles." },
          "color": { "type": "string", "description": "Exterior color." },
          "vin": { "type": "string", "description": "Vehicle identification number." }
        }
      },
      "PurchaseQuote": {
        "title": "Purchase quote",
        "type": "object",
        "description": "Itemized out-the-door quote.",
        "required": ["quoteId", "vehicleId", "subtotal", "taxes", "fees", "total"],
        "properties": {
          "quoteId": { "type": "string" },
          "vehicleId": { "type": "string" },
          "subtotal": { "type": "number", "minimum": 0 },
          "taxes": { "type": "number", "minimum": 0 },
          "fees": { "type": "number", "minimum": 0 },
          "tradeInCredit": { "type": "number", "minimum": 0 },
          "total": { "type": "number", "minimum": 0 }
        }
      },
      "Applicant": {
        "title": "Financing applicant",
        "type": "object",
        "description": "Primary buyer applying for financing.",
        "required": ["fullName", "email", "annualIncome"],
        "properties": {
          "fullName": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "annualIncome": { "type": "number", "minimum": 0 },
          "employmentYears": { "type": "number", "minimum": 0 }
        }
      },
      "FinancingOffer": {
        "title": "Financing offer",
        "type": "object",
        "description": "Pre-approved loan terms.",
        "required": ["offerId", "apr", "termMonths", "monthlyPayment"],
        "properties": {
          "offerId": { "type": "string" },
          "apr": { "type": "number", "minimum": 0 },
          "termMonths": { "type": "integer", "minimum": 1 },
          "monthlyPayment": { "type": "number", "minimum": 0 }
        }
      },
      "ContactInfo": {
        "title": "Buyer contact information",
        "type": "object",
        "description": "Buyer contact information.",
        "required": ["fullName", "phone", "email"],
        "properties": {
          "fullName": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "TestDriveAppointment": {
        "title": "Test-drive appointment",
        "type": "object",
        "description": "Scheduled test drive.",
        "required": ["appointmentId", "vehicleId", "scheduledAt", "dealershipAddress"],
        "properties": {
          "appointmentId": { "type": "string" },
          "vehicleId": { "type": "string" },
          "scheduledAt": { "type": "string", "format": "date-time" },
          "dealershipAddress": { "type": "string" }
        }
      },
      "PurchaseRecord": {
        "title": "Purchase record",
        "type": "object",
        "description": "Completed purchase.",
        "required": ["purchaseId", "vehicleId", "totalPaid", "estimatedDeliveryDate"],
        "properties": {
          "purchaseId": { "type": "string" },
          "vehicleId": { "type": "string" },
          "totalPaid": { "type": "number", "minimum": 0 },
          "estimatedDeliveryDate": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
